rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // admins/{uid}: {role: "owner", enabled}. Provisioned ONLY via Console/Admin SDK.
    // catalog/main/categories/{id}: {name, sort} public catalog.
    // catalog/main/products/{id}: see data/catalog.json; photo <=180 KB Base64.
    // branches/{branch}/orders/{id}: immutable customer, basket and estimated total;
    // owner may update ONLY status, finalTotalCents (positive int <=1e9), updatedAt. Prices are estimates and must
    // be confirmed by the store before payment. No online payment is performed.
    function signedIn() { return request.auth != null; }
    function validBranch(branch) { return branch in ['coronel', 'bingen', 'correas']; }
    function catalogAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "owner";
    }
    function storeAdmin(branch) { return validBranch(branch) && catalogAdmin(); }
    function str(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function validCategory(d) {
      return d.keys().hasAll(['name','sort']) && d.keys().hasOnly(['name','sort'])
        && str(d.name,1,60) && d.sort is int && d.sort >= 0 && d.sort <= 999;
    }
    function validProduct(d) {
      return d.keys().hasAll(['name','categoryId','description','unit','saleMode','weightGrams','priceCents','variants','image','imagePath','active','sort','reviewRequired'])
        && d.keys().hasOnly(['name','categoryId','description','unit','saleMode','weightGrams','priceCents','variants','image','imagePath','active','sort','reviewRequired'])
        && str(d.name,1,100) && str(d.categoryId,1,128) && str(d.description,0,2000)
        && d.unit in ['kg','un'] && d.saleMode in ['weight','piece','unit']
        && (d.unit == 'un' ? d.saleMode == 'unit' : d.saleMode != 'unit')
        && d.priceCents is int && d.priceCents > 0 && d.priceCents <= 10000000
        && d.weightGrams is int && d.weightGrams >= 0 && d.weightGrams <= 30000
        && (d.saleMode != 'piece' || d.weightGrams > 0)
        && d.variants is list && d.variants.size() > 0 && d.variants.size() <= 20
        && str(d.image,0,180000) && str(d.imagePath,0,300)
        && d.active is bool && d.reviewRequired is bool && d.sort is int && d.sort >= 0;
    }
    function validCustomer(c) {
      return c is map && c.keys().hasAll(['name','phone']) && c.keys().hasOnly(['name','phone'])
        && str(c.name,2,80) && c.phone is string && c.phone.matches('^[1-9][0-9]{9,10}$');
    }
    // These are customer-supplied estimates, not a trusted charge or invoice.
    // Validate the display envelope here; staff confirm authoritative product prices.
    function validLine(l) {
      let notes = l.get("notes", "");
      return l is map && l.name is string && l.totalCents is int && l.totalCents > 0
        && notes is string && notes.size() <= 300;
    }
    function validOrder(d, branch, checkItems) {
      return d.keys().hasAll(['code','customer','fulfillment','payment','address','changeFor','notes','branchId','items','totalCents','status','ownerUid','createdAt','updatedAt'])
        && d.keys().hasOnly(['code','customer','fulfillment','payment','address','changeFor','notes','branchId','items','totalCents','status','ownerUid','createdAt','updatedAt','finalTotalCents'])
        && d.branchId == branch && str(d.code,8,8) && str(d.ownerUid,1,128) && validCustomer(d.customer)
        && d.fulfillment in ['delivery','pickup']
        && d.payment in ['Pix','Cartão de crédito','Cartão de débito','Dinheiro']
        && str(d.address,0,400) && (d.fulfillment != 'delivery' || d.address.size() >= 10)
        && str(d.changeFor,0,40) && str(d.notes,0,500)
        && d.status in ['pending','done']
        && (!('finalTotalCents' in d) || (d.finalTotalCents is int && d.finalTotalCents > 0 && d.finalTotalCents <= 1000000000))
        && d.totalCents is int && d.totalCents > 0 && d.totalCents <= 1000000000
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && d.items is list && d.items.size() > 0 && d.items.size() <= 10
        // On update the diff allowlist makes items and estimated total immutable.
        // Validate their contents on create only, to stay within the Rules expression budget.
        && (!checkItems || (validItems(d.items) && d.totalCents == sum0(d.items)));
    }
    // Item validation is expanded below because Rules deliberately have no loops.
    function validItems(items) {
      let n = items.size();
      return validLine(items[0])
        && (n <= 1 || validLine(items[1]))
        && (n <= 2 || validLine(items[2]))
        && (n <= 3 || validLine(items[3]))
        && (n <= 4 || validLine(items[4]))
        && (n <= 5 || validLine(items[5]))
        && (n <= 6 || validLine(items[6]))
        && (n <= 7 || validLine(items[7]))
        && (n <= 8 || validLine(items[8]))
        && (n <= 9 || validLine(items[9]))
        ;
    }
    function sum0(items) {
      let n = items.size();
      return items[0].totalCents
        + (n > 1 ? items[1].totalCents : 0)
        + (n > 2 ? items[2].totalCents : 0)
        + (n > 3 ? items[3].totalCents : 0)
        + (n > 4 ? items[4].totalCents : 0)
        + (n > 5 ? items[5].totalCents : 0)
        + (n > 6 ? items[6].totalCents : 0)
        + (n > 7 ? items[7].totalCents : 0)
        + (n > 8 ? items[8].totalCents : 0)
        + (n > 9 ? items[9].totalCents : 0)
        ;
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /catalog/main/categories/{categoryId} {
      allow read: if true;
      allow create, update: if catalogAdmin() && validCategory(request.resource.data);
      allow delete: if catalogAdmin();
    }
    match /catalog/main/products/{productId} {
      allow read: if resource.data.active == true || catalogAdmin();
      allow create, update: if catalogAdmin() && validProduct(request.resource.data);
      allow delete: if catalogAdmin();
    }
    // Read-only compatibility for already-open older storefronts. Single source for all edits above.
    match /branches/{branch}/categories/{categoryId} {
      allow read: if validBranch(branch);
      allow write: if false;
    }
    match /branches/{branch}/products/{productId} {
      allow read: if validBranch(branch) && (resource.data.active == true || storeAdmin(branch));
      allow write: if false;
    }
    match /branches/{branch}/orders/{orderId} {
      allow get: if storeAdmin(branch) || (signedIn() && (resource == null || resource.data.ownerUid == request.auth.uid));
      allow list: if storeAdmin(branch);
      allow create: if validBranch(branch) && signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && !('finalTotalCents' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validOrder(request.resource.data, branch, true);
      allow update: if storeAdmin(branch)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','finalTotalCents','updatedAt'])
        && (request.resource.data.status != 'done' || 'finalTotalCents' in request.resource.data)
        && request.resource.data.updatedAt == request.time
        && validOrder(request.resource.data, branch, false);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
