rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function catalogAdmin() {
      return request.auth != null && request.auth.token.catalogAdmin == true;
    }
    match /catalog/products/{filename} {
      allow read: if true;
      allow create, update: if catalogAdmin()
        && request.resource.size < 200000
        && request.resource.contentType == 'image/jpeg';
      allow delete: if catalogAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
